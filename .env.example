APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Stock monitor
# --------------------------------------------------------------------------

MONITOR_MASTER_SOURCE=onlinefact
MONITOR_BATCH_QUEUE=monitor

# Onlinefact ERP — https://admin.onlinefact.be > Configuration > API
ONLINEFACT_API_URL=https://api.onlinefact.be
ONLINEFACT_API_KEY=
ONLINEFACT_API_SECRET=

# WooCommerce — Woocommerce > Settings > Advanced > REST API (read permission is enough)
WOOCOMMERCE_DEKOOKWINKEL_URL=https://dekookwinkel.be
WOOCOMMERCE_DEKOOKWINKEL_KEY=
WOOCOMMERCE_DEKOOKWINKEL_SECRET=

WOOCOMMERCE_KORALY_URL=https://koralybv.com
WOOCOMMERCE_KORALY_KEY=
WOOCOMMERCE_KORALY_SECRET=

WOOCOMMERCE_OUTLET_ELEKTRO_URL=https://outlet-elektro.be
WOOCOMMERCE_OUTLET_ELEKTRO_KEY=
WOOCOMMERCE_OUTLET_ELEKTRO_SECRET=

# Bol.com Retailer API — one client id/secret per seller account (Mijn account > Instellingen > API)
BOL_AUTH_URL=https://login.bol.com/token
BOL_API_URL=https://api.bol.com/retailer
BOL_ACCEPT_HEADER=application/vnd.retailer.v11+json

BOL_KORALY_BE_CLIENT_ID=
BOL_KORALY_BE_CLIENT_SECRET=

BOL_KORALY_NL_CLIENT_ID=
BOL_KORALY_NL_CLIENT_SECRET=

BOL_OUTLET_ELEKTRO_BE_CLIENT_ID=
BOL_OUTLET_ELEKTRO_BE_CLIENT_SECRET=

BOL_OUTLET_ELEKTRO_NL_CLIENT_ID=
BOL_OUTLET_ELEKTRO_NL_CLIENT_SECRET=
